# Kopieren nach .env und die drei Geheimnisse erzeugen — bewusst ohne Vorgabewerte:
# ein mitgeliefertes Passwort waere auf jeder Instanz dasselbe und stuende obendrein
# oeffentlich im Repo. Der Bildspeicher ist fuer die Geraete der Gaeste erreichbar,
# ein bekanntes Passwort waere dort also unmittelbar ausnutzbar.
#
#   printf 'JWT_SECRET=%s\nDB_PASSWORD=%s\nSTORAGE_PASSWORD=%s\n' \
#     "$(openssl rand -base64 48)" "$(openssl rand -base64 24)" "$(openssl rand -base64 24)" >> .env

# Signaturschluessel der Tokens, mindestens 32 Zeichen.
JWT_SECRET=

# Passwort der Datenbank.
DB_PASSWORD=

# Zugangsdaten des Bildspeichers (MinIO-Root).
STORAGE_USER=partypic
STORAGE_PASSWORD=

# Port, unter dem die App auf dem Host erreichbar ist. 8080 waere naheliegend, ist aber
# oft schon vergeben — deshalb 8088 als Vorgabe.
APP_PORT=8088

# Adresse, unter der die Geraete der Gaeste den Bildspeicher erreichen.
# Im heimischen WLAN die IP des Rechners eintragen — "localhost" zeigt auf dem Handy
# auf das Handy selbst, und die Bilder blieben grau.
PUBLIC_STORAGE_URL=http://localhost:9000

# Auf false stellen, sobald der eigene Gastgeber-Account angelegt ist.
ALLOW_REGISTRATION=true
