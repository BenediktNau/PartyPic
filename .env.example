# Kopieren nach .env — nur JWT_SECRET muss wirklich gesetzt werden.

# Signaturschlüssel der Tokens. Mindestens 32 Zeichen, z. B.:
#   openssl rand -base64 48
JWT_SECRET=

# Adresse, unter der die Geräte der Gäste den Bildspeicher erreichen.
# Im heimischen WLAN die IP des Rechners eintragen — "localhost" zeigt auf dem Handy
# auf das Handy selbst, und die Bilder blieben grau.
PUBLIC_STORAGE_URL=http://localhost:9000

# Zugangsdaten für Datenbank und Bildspeicher.
DB_PASSWORD=partypic
STORAGE_USER=partypic
STORAGE_PASSWORD=partypic-secret

# Auf false stellen, sobald der eigene Gastgeber-Account angelegt ist.
ALLOW_REGISTRATION=true
